# Panel agencia
DASHBOARD_PASSWORD=cambia-esta-clave
PUBLIC_BASE_URL=https://tu-proyecto.vercel.app

# Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx
SUPABASE_BACKEND_SECRET=genera-un-secreto-largo
# Fallback legacy opcional:
# SUPABASE_ANON_KEY=eyJ...

# Meta / WhatsApp
# Un único token de sistema puede administrar varios clientes si tiene acceso a sus activos.
WHATSAPP_VERIFY_TOKEN=token-verificacion-webhook
META_ACCESS_TOKEN=EAAB...
META_GRAPH_VERSION=v25.0
META_CAPI_TEST_EVENT_CODE=

# Fallback sólo para el primer cliente (IndumentariaSinLimite).
# Los clientes nuevos guardan estos IDs en la tabla clients desde el panel.
WABA_ID=123456789012345
META_DATASET_ID=123456789012345
META_AD_ACCOUNT_ID=act_123456789012345

# Mercado Pago (opcional; por ahora integración global)
MP_ACCESS_TOKEN=APP_USR-...
